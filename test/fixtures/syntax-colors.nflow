@nflow_version ">=0.103.0"
@schema ErrorEnvelope {
  xerr Error `json:"xerr" validate:"required"`
  on_error string `json:"on_error" validate:"omitempty,oneof=fail recover"`
  input Input `json:"input"`
  result Result `json:"result"`
  Message string `json:"message" default:"failed" validation:"required"`
}

@pipeline on_timeout
  :retry=2
  runtime.fail ( kind: "Timeout", message: "slow upstream" )
@end

@schema TypedRequest {
  Name string `json:"name"`
}
@schema TypedResponse {
  Name string `json:"name"`
}
@pipeline typed_order(order_req: !TypedRequest): !TypedResponse
  :retry=2
  { name: order_req.name }
@end

@pipeline typed_status(): TypedResponse
  { name: "ready" }
@end

runtime.fail ( kind: "Timeout" )
  -> pipeline.on_timeout
:timeout=5s
