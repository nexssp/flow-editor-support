// Representative syntax from the current Flow language reference.
@nflow_version ">=0.95.0"
@description "Editor grammar coverage"
@require retry as helpers {
  default_max: "2"
  backoff: "constant"
  min_backoff: "1ns"
  max_backoff: "1ns"
  retry_all: "true"
}
@func commerce.shippingFeeMinor(subtotalMinor int, destinationZone string) int {
  destinationZone == "domestic" && subtotalMinor >= 5000
    ? 0
    : (destinationZone == "domestic" ? 599 : 1299)
}
@func commerce.taxMinor(subtotalMinor int, ratePercent int) int = subtotalMinor * ratePercent / 100

@pipeline editor_syntax_v095
  runtime.wrap ( value: { Known: true, snapshot: { .customer.id } } ) as estimate
  -> {
    known: estimate.Known,
    .customer.id,
    .customer.profile.email,
    ... .state,
    ...input.state,
    status: "ready"
  }
@end

@schema Request {
  Name string `json:"name" default:"standard" validate:"required"`
  Depth int `json:"depth" default:"1" validate:"gte=1"`
}

{ level: 4, danger: true, mode: true ? "yes" : "no", fallback: .metadata.ip_address ?? "127.0.0.1", n: 0 }
-> parallel {
  profile: runtime.wrap ( value: "profile-ready" ),
  metrics: runtime.wrap ( value: `metrics:ready` ),
}
-> race {
  fail ( kind: "Unavailable", message: "this candidate fails" ),
  runtime.wrap ( value: "winner" ),
}
-> match {
  .danger && .level > 3
  -> runtime.wrap ( value: "critical" ),
  .danger
  -> runtime.wrap ( value: "warning" ),
  _
  -> runtime.wrap ( value: { n: 0, level: 0, danger: false } )
}
-> if (.danger && .level > 3) {
  runtime.wrap ( value: "critical" )
} else if (.danger) {
  runtime.wrap ( value: "warning" )
} else {
  runtime.wrap ( value: { n: 0, level: 0, danger: false } )
}
-> [1, 2, 3] -> each :concurrency=4 {
  runtime.noop
}
-> loop({ n: .n + 1 }) until(.n >= 3)
-> assert ( .n == 3, "loop counter should reach 3" )
-> runtime.wrap ( value: { ok: true, items: ["nonempty"] } )
-> runtime.noop @review #security,quality ~slow ( value: { ok: true, items: ["nonempty"] } )

@assert: result.ok == true
@assert result.items[0] == "nonempty"
@assert {
  result.ok == true
  all(result.items, # != "")
}
@assert: { result.ok == true, all(result.items, # != ""), result.items[0] == "nonempty" }

@pipeline modifier_style
  :timeout=2s
  :retry=2

  runtime.noop :timeout=1s :retry=1 ( value: "readable" )
@end
