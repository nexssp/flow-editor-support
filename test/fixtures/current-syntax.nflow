// Representative syntax from the current Flow language reference.
@nflow_version ">=0.44.1"
@description "Editor grammar coverage"
@require retry as helpers {
  default_max: "2",
  backoff: "constant",
  min_backoff: "1ns",
  max_backoff: "1ns",
  retry_all: "true"
}
@schema Request {
  Name string `json:"name" default:"standard" validate:"required"`
  Depth int `json:"depth" default:"1" validate:"gte=1"`
}

{ level: 4, danger: true, mode: true ? "yes" : "no", n: 0 }
-> parallel {
  profile: const @{ value: "profile-ready" },
  metrics: const @{ value: `metrics:ready` },
}
-> race {
  fail @{ kind: "Unavailable", message: "this candidate fails" },
  const @{ value: "winner" },
}
-> match {
  .danger && .level > 3
    -> const @{ value: "critical" },
  .danger
    -> const @{ value: "warning" },
  _
    -> const @{ value: { n: 0, level: 0, danger: false } }
}
-> loop({ n: .n + 1 }) until(.n >= 3)
-> assert(.n == 3, "loop counter should reach 3")
-> runtime.const @{ value: { ok: true, items: ["nonempty"] } }
-> runtime.const @review #security, quality ~slow @{ value: { ok: true, items: ["nonempty"] } }

@assert: result.ok == true
@assert result.items[0] == "nonempty"
@assert {
  result.ok == true
  all(result.items, # != "")
}
@assert: { result.ok == true, all(result.items, # != ""), result.items[0] == "nonempty" }

@pipeline modifier_style
  :timeout=2s
  :retry=2

  runtime.const :timeout=1s :retry=1 @{ value: "readable" }
@end
