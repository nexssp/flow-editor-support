{
  "Sequential pipeline": {
    "prefix": "flow-pipe",
    "body": ["${1:source.node}", "-> ${2:target.node}", ""],
    "description": "Create a sequential Flow pipeline"
  },
  "Parallel fan-out": {
    "prefix": "flow-parallel",
    "body": ["( ${1:first.node} & ${2:second.node} )"],
    "description": "Run Flow nodes in parallel"
  },
  "Fallback chain": {
    "prefix": "flow-fallback",
    "body": ["( ${1:primary.node} || ${2:fallback.node} )"],
    "description": "Try the next node when the previous node fails"
  },
  "Conditional node": {
    "prefix": "flow-if",
    "body": ["${1:gate} ? ${2:target.node}"],
    "description": "Run a target when the gate output is truthy"
  },
  "Projection": {
    "prefix": "flow-projection",
    "body": ["{ ${1:field}: ${2:.input} }"],
    "description": "Reshape the payload with an inline projection"
  },
  "Bounded loop": {
    "prefix": "flow-loop",
    "body": ["loop(", "  ${1:body.node}", ") until( ${2:condition} )"],
    "description": "Create a bounded autonomous loop"
  },
  "Directive block": {
    "prefix": "flow-directive",
    "body": ["@${1:config}:${2:key}=${3:value}"],
    "description": "Add a Flow preprocessing directive"
  },
  "Configured node": {
    "prefix": "flow-node",
    "body": ["${1:namespace.node}:timeout=${2:10s}:retry=${3:2}:cache=${4:5m}"],
    "description": "Add a node with common resilience modifiers"
  },
  "Named pipeline": {
    "prefix": "flow-pipeline",
    "body": ["@pipeline ${1:name}", "  ${2:source.node}", "  -> ${3:target.node}", "@end"],
    "description": "Declare a reusable named pipeline"
  },
  "Require library": {
    "prefix": "flow-require",
    "body": ["@require ${1:./local/path}"],
    "description": "Import a Flow library"
  }
}
