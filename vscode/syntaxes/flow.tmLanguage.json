{
  "scopeName": "source.flow",
  "name": "Nexss Flow",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#loop"
    },
    {
      "include": "#projection"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#atoms"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#targets"
    },
    {
      "include": "#prompts"
    },
    {
      "include": "#excludes"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.flow",
          "match": "^(\\s*)//.*$"
        },
        {
          "name": "comment.line.double-slash.flow",
          "match": "//.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.directive.flow",
          "match": "^(\\s*)(@)([A-Za-z_][A-Za-z0-9_.-]*)(?::)?",
          "captures": {
            "2": {
              "name": "punctuation.definition.directive.flow"
            },
            "3": {
              "name": "keyword.control.directive.flow"
            }
          }
        }
      ]
    },
    "loop": {
      "patterns": [
        {
          "name": "keyword.control.loop.flow",
          "match": "\\b(loop|until)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.flow",
          "match": "->|\\|\\||\\||&|\\?"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.flow",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.flow",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.flow",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.flow",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.flow",
          "match": "(?<![A-Za-z_])-?[0-9]+(?:\\.[0-9]+)?"
        }
      ]
    },
    "atoms": {
      "patterns": [
        {
          "name": "entity.name.function.flow",
          "match": "(?<![A-Za-z0-9_./-])[A-Za-z_\\.][A-Za-z0-9_\\.\\/-]*(?=(?:\\s|:|@|#|~|\\)|\\}|&|\\?|,|$))"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "meta.modifier.flow",
          "match": ":([A-Za-z_][A-Za-z0-9_]*)(?:=(\"(?:[^\"\\\\]|\\\\.)*\"|\\'(?:[^\\'\\\\]|\\\\.)*\\'|[^\\s:(){}&?|]+))?",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.flow"
            },
            "2": {
              "name": "string.unquoted.modifier.flow"
            }
          }
        }
      ]
    },
    "targets": {
      "patterns": [
        {
          "name": "variable.parameter.target.flow",
          "match": "#[A-Za-z_\\.][A-Za-z0-9_\\.\\/-]*(?:\\s*,\\s*[A-Za-z_\\.][A-Za-z0-9_\\.\\/-]*)*"
        }
      ]
    },
    "prompts": {
      "patterns": [
        {
          "name": "string.unquoted.prompt.flow",
          "match": "@[A-Za-z_][A-Za-z0-9_.\\/-]*"
        }
      ]
    },
    "projection": {
      "patterns": [
        {
          "name": "meta.projection.flow",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.projection.begin.flow"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.projection.end.flow"
            }
          },
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#atoms"
            },
            {
              "name": "entity.other.attribute-name.field.flow",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*(?=:)"
            }
          ]
        }
      ]
    },
    "excludes": {
      "patterns": [
        {
          "name": "variable.parameter.exclude.flow",
          "match": "~[A-Za-z_\\.][A-Za-z0-9_\\.\\/-]*(?:\\s*,\\s*[A-Za-z_\\.][A-Za-z0-9_\\.\\/-]*)*"
        }
      ]
    }
  }
}
