{
  "name": "nexss-flow-syntax",
  "displayName": "Nexss Flow",
  "description": "Syntax highlighting, snippets, and LSP stub support for Nexss Flow .nflow files",
  "version": "0.1.0",
  "publisher": "nexssp",
  "icon": "icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexssp/flow-editor-support"
  },
  "engines": { "vscode": ">=1.80.0" },
  "main": "./extension.js",
  "activationEvents": ["onLanguage:nexss-flow"],
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "nexss-flow",
      "aliases": ["Nexss Flow", "Flow"],
      "extensions": [".nflow"],
      "configuration": "./language-configuration.json"
    }],
    "snippets": [{
      "language": "nexss-flow",
      "path": "./snippets/flow.code-snippets"
    }],
    "grammars": [{
      "language": "nexss-flow",
      "scopeName": "source.nflow",
      "path": "./syntaxes/flow.tmLanguage.json"
    }],
    "configuration": {
      "title": "Nexss Flow",
      "properties": {
        "nexssFlow.languageServer.command": {
          "type": "string",
          "default": "",
          "description": "Optional executable for a compatible stdio language server. Leave blank to use the bundled Flow server."
        },
        "nexssFlow.languageServer.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Arguments passed to the custom language-server executable."
        }
      }
    }
  }
}
