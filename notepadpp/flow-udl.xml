<NotepadPlus>
  <UserLang name="Nexss Flow" ext="flow" udlVersion="2.1">
    <Settings>
      <Global caseIgnored="no" allowFoldOfComments="yes" foldCompact="no" forcePureLang="no" decimalSeparator="0" />
      <Prefix Keywords1="no" Keywords2="no" Keywords3="no" Keywords4="no" Keywords5="no" Keywords6="no" />
    </Settings>
    <KeywordLists>
      <Keywords name="Comments">00// 01 02 03 04</Keywords>
      <Keywords name="Numbers, prefix1">-</Keywords>
      <Keywords name="Numbers, prefix2"></Keywords>
      <Keywords name="Numbers, extras1">.[0-9]</Keywords>
      <Keywords name="Numbers, extras2"></Keywords>
      <Keywords name="Numbers, suffix1">s m h ms us</Keywords>
      <Keywords name="Numbers, suffix2"></Keywords>
      <Keywords name="Numbers, range"></Keywords>
      <Keywords name="Operators1">-&gt; || | &amp; ? ~</Keywords>
      <Keywords name="Operators2">= : ,</Keywords>
      <Keywords name="Folders in code1, open">( {</Keywords>
      <Keywords name="Folders in code1, middle"></Keywords>
      <Keywords name="Folders in code1, close">) }</Keywords>
      <Keywords name="Folders in code2, open"></Keywords>
      <Keywords name="Folders in code2, middle"></Keywords>
      <Keywords name="Folders in code2, close"></Keywords>
      <Keywords name="Folders in comment, open"></Keywords>
      <Keywords name="Folders in comment, middle"></Keywords>
      <Keywords name="Folders in comment, close"></Keywords>
      <Keywords name="Keywords1">loop until</Keywords>
      <Keywords name="Keywords2">config assert pipeline include action description require end</Keywords>
      <Keywords name="Keywords3">retry timeout cache auth validate idempotent coalesce dedup route http status role perm feature scope model</Keywords>
      <Keywords name="Keywords4">true false nil</Keywords>
      <Keywords name="Keywords5"></Keywords>
      <Keywords name="Keywords6"></Keywords>
      <Keywords name="Delimiters">00&quot; 01&quot; 02&quot; 03' 04' 05' 06{ 07} 08( 09) 10 11 12</Keywords>
    </KeywordLists>
    <Styles>
      <WordsStyle name="DEFAULT" fgColor="D4D4D4" bgColor="1E1E1E" fontName="Consolas" fontStyle="0" nesting="0" />
      <WordsStyle name="COMMENTS" fgColor="6A9955" bgColor="1E1E1E" fontStyle="2" nesting="0" />
      <WordsStyle name="LINE COMMENTS" fgColor="6A9955" bgColor="1E1E1E" fontStyle="2" nesting="0" />
      <WordsStyle name="NUMBER" fgColor="B5CEA8" bgColor="1E1E1E" fontStyle="0" nesting="0" />
      <WordsStyle name="KEYWORDS1" fgColor="C586C0" bgColor="1E1E1E" fontStyle="1" nesting="0" />
      <WordsStyle name="KEYWORDS2" fgColor="569CD6" bgColor="1E1E1E" fontStyle="1" nesting="0" />
      <WordsStyle name="KEYWORDS3" fgColor="9CDCFE" bgColor="1E1E1E" fontStyle="0" nesting="0" />
      <WordsStyle name="KEYWORDS4" fgColor="569CD6" bgColor="1E1E1E" fontStyle="0" nesting="0" />
      <WordsStyle name="OPERATORS" fgColor="DCDCAA" bgColor="1E1E1E" fontStyle="1" nesting="0" />
      <WordsStyle name="DELIMITERS1" fgColor="CE9178" bgColor="1E1E1E" fontStyle="0" nesting="0" />
    </Styles>
  </UserLang>
</NotepadPlus>
