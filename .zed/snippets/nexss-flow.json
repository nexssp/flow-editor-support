{
  "flow-pipe": {
    "prefix": "flow-pipe",
    "body": ["${1:source.node}", "-> ${2:target.node}"],
    "description": "Sequential Flow pipeline"
  },
  "flow-args": {
    "prefix": "flow-args",
    "body": ["${1:action.node} @{ ${2:value}: ${3:.input} }"],
    "description": "Structured action arguments"
  },
  "flow-parallel": {
    "prefix": "flow-parallel",
    "body": ["parallel {", "  ${1:profile}: ${2:profile.action},", "  ${3:metrics}: ${4:metrics.action},", "}"],
    "description": "Named concurrent branches"
  },
  "flow-race": {
    "prefix": "flow-race",
    "body": ["race {", "  ${1:first.action},", "  ${2:second.action},", "}"],
    "description": "First successful branch"
  },
  "flow-match": {
    "prefix": "flow-match",
    "body": ["match {", "  ${1:.condition} -> ${2:action.one},", "  _ -> ${3:action.other}", "}"],
    "description": "Ordered match arms"
  },
  "flow-assert": {
    "prefix": "flow-assert",
    "body": ["@assert {", "  ${1:result.ok == true}", "}"],
    "description": "Post-run assertion block"
  },
  "flow-assert-expression": {
    "prefix": "flow-assert-expression",
    "body": ["@assert: ${1:result.ok == true}"],
    "description": "Flow v0.42.0 post-run assertion"
  },
  "flow-assert-inline": {
    "prefix": "flow-assert-inline",
    "body": ["@assert: { ${1:result.ok == true}, ${2:result.count > 0} }"],
    "description": "Flow v0.42.0 comma-separated assertions"
  },
  "flow-assert-call": {
    "prefix": "flow-assert-call",
    "body": ["assert(${1:condition}, \"${2:failure message}\")"],
    "description": "Assert a condition while the pipeline runs"
  },
  "flow-node": {
    "prefix": "flow-node",
    "body": ["${1:namespace.node}:timeout=${2:10s}:retry=${3:2}"],
    "description": "Configured action node"
  },
  "flow-pipeline": {
    "prefix": "flow-pipeline",
    "body": ["@pipeline ${1:name}", "  :timeout=10s", "  ${2:source.node}", "@end"],
    "description": "Named reusable pipeline"
  }
}
